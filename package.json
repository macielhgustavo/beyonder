{
  "name": "beyonder",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous economic agent runtime with zero-cost-first compute acquisition.",
  "type": "module",
  "bin": {
    "beyonder": "./apps/cli/dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:compute && pnpm test:tools && pnpm test:runtime && pnpm test:benchmark && pnpm test:browser && pnpm test:web-evals && pnpm test:integration",
    "test:compute": "tsx --test packages/compute/src/*.test.ts",
    "test:tools": "vitest run packages/tools/src",
    "test:runtime": "vitest run packages/runtime/src/**/*.test.ts",
    "test:benchmark": "vitest run packages/benchmark/src/**/*.test.ts",
    "test:browser": "vitest run packages/browser-agent/src/action-parser.test.ts packages/browser-agent/src/policy.test.ts packages/browser-agent/src/ssrf-boundary.test.ts packages/browser-agent/src/redaction.test.ts packages/browser-agent/src/browser-agent.test.ts packages/browser-agent/src/browser-tools.test.ts",
    "test:web-evals": "vitest run packages/web-evals/src",
    "test:integration": "vitest run tests/integration",
    "browser:smoke": "tsx packages/browser-agent/src/smoke.ts",
    "web:evals:smoke": "tsx packages/web-evals/src/cli.ts smoke",
    "web:evals:standard": "tsx packages/web-evals/src/cli.ts standard",
    "autonomy:smoke": "tsx packages/web-evals/src/autonomy-cli.ts",
    "hardening:smoke": "tsx packages/runtime/src/tasks/hardening-smoke.ts",
    "opportunities:smoke": "tsx packages/web-evals/src/opportunity-cli.ts",
    "opportunities:real-smoke": "tsx -e \"import('./packages/web-evals/src/opportunity.js').then(async ({runRealSourceReadOnlySmoke}) => console.log(JSON.stringify(await runRealSourceReadOnlySmoke(), null, 2)))\"",
    "marketplace:real-smoke": "tsx -e \"import('./packages/web-evals/src/opportunity.js').then(async ({runMarketplaceReadOnlySmoke}) => console.log(JSON.stringify(await runMarketplaceReadOnlySmoke(), null, 2)))\"",
    "approvals:smoke": "tsx -e \"import('./packages/web-evals/src/opportunity.js').then(async ({runApprovalE2E}) => console.log(JSON.stringify(await runApprovalE2E(), null, 2)))\"",
    "work-loop:smoke": "tsx packages/web-evals/src/work-loop-cli.ts",
    "start": "tsx apps/cli/src/index.ts",
    "beyonder": "tsx apps/cli/src/index.ts",
    "control-center": "pnpm --filter @beyonder/control-center dev",
    "control-center:build": "pnpm build && pnpm --filter @beyonder/control-center build",
    "control-center:typecheck": "pnpm --filter @beyonder/control-center typecheck",
    "control-center:test": "pnpm --filter @beyonder/control-center test",
    "control-center:smoke": "pnpm --filter @beyonder/control-center smoke",
    "control-center:launch": "node apps/dashboard/bin/launch-control-center.mjs",
    "control-center:install-launcher": "node apps/dashboard/bin/install-linux-launcher.mjs",
    "dashboard": "pnpm control-center",
    "dashboard:build": "pnpm control-center:build",
    "dashboard:typecheck": "pnpm control-center:typecheck",
    "dashboard:test": "pnpm control-center:test",
    "providers:autopilot": "tsx apps/cli/src/index.ts providers autopilot",
    "providers:resume": "tsx apps/cli/src/index.ts providers resume",
    "providers:discover": "tsx apps/cli/src/index.ts providers discover",
    "providers:inventory": "tsx apps/cli/src/index.ts providers inventory",
    "providers:status": "tsx apps/cli/src/index.ts providers status",
    "providers:nvidia-smoke": "tsx packages/benchmark/src/models/nvidia-nim-smoke.ts",
    "control-center:security-smoke": "pnpm --filter @beyonder/control-center security-smoke",
    "control-center:supervisor-smoke": "pnpm --filter @beyonder/control-center supervisor-smoke"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@beyonder/compute": "workspace:*",
    "@beyonder/economy": "workspace:*",
    "@beyonder/runtime": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "nanoid": "^5.0.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
